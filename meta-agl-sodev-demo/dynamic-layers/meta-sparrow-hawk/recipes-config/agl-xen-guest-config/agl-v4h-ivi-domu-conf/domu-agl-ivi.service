[Unit]
Description=DomAGL-IVI
Requires=backend-ready@bridge.service backend-ready@compositor-up.service
After=backend-ready@bridge.service backend-ready@compositor-up.service

[Service]
Type=simple
ExecStart=/usr/lib/xen/bin/launch-domain DomAGL-IVI /etc/xen/domu-agl-ivi.cfg
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
